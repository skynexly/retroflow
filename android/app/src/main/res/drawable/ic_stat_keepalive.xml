<?xml version="1.0" encoding="utf-8"?>
<!-- 后台驻留通知小图标：orb 圆环 + 中心核点。
     系统要求通知小图标为纯白剪影（只认 alpha），着色由系统按主题决定，故 fillColor 写白。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 外环：外径 10、内径 8 的圆环。两段弧方向相反，nonZero / evenOdd 下都镂空 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2A10,10 0,1 1,12,22A10,10 0,1 1,12,2ZM12,4A8,8 0,1 0,12,20A8,8 0,1 0,12,4Z" />
    <!-- 核点：r=3.5 的实心圆 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8.5A3.5,3.5 0,1 1,12,15.5A3.5,3.5 0,1 1,12,8.5Z" />
</vector>
