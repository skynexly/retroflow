{
  "name": "retroflow-project",
  "version": "1.0.0",
  "private": true,
  "description": "溯流计划 · 执行员终端 PWA（Capacitor Android 壳）",
  "scripts": {
    "build:www": "node scripts/build-www.js",
    "cap:sync": "node scripts/build-www.js && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2"
  }
}
