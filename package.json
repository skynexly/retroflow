{
  "name": "retroflow-project",
  "version": "1.0.0",
  "private": true,
  "description": "溯流计划 · 执行员终端 PWA（Capacitor Android 壳）",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "version:check": "node scripts/sync-version.js --check",
    "build:www": "node scripts/sync-version.js && node scripts/build-www.js",
    "cap:sync": "node scripts/sync-version.js && node scripts/build-www.js && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:debug": "node scripts/sync-version.js && cd android && ./gradlew assembleDebug",
    "android:release": "node scripts/sync-version.js && cd android && ./gradlew assembleRelease",
    "ota:publish": "node scripts/publish-ota.js"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/cli": "6.2.2",
    "@capacitor/core": "6.2.2"
  },
  "dependencies": {
    "@capacitor/filesystem": "6.0.4"
  }
}
